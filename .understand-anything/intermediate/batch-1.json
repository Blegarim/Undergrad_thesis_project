      "id": "file:models/Unified_Module.py",
      "type": "file",
      "name": "Unified_Module.py",
      "filePath": "models/Unified_Module.py",
      "summary": "Top-level ensemble model that wires the ViT visual encoder, motion encoder, and cross-attention fusion module together with LayerNorm normalization before fusion.",
      "tags": ["entry-point", "neural-network", "component", "orchestration"],
      "complexity": "simple"
    },
    {
      "id": "class:models/Unified_Module.py:EnsembleModel",
      "type": "class",
      "name": "EnsembleModel",
      "filePath": "models/Unified_Module.py",
      "lineRange": [4, 28],
      "summary": "Orchestrates the full multimodal pipeline: ViT processes context crops, MotionEncoder processes tight crops and motion sequences, both are LayerNormed, then fused via cross-attention to produce task logits.",
