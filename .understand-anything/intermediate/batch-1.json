      "complexity": "moderate"
    },
    {
      "id": "class:models/AblationModels.py:MotionOnlyModel",
      "type": "class",
      "name": "MotionOnlyModel",
      "filePath": "models/AblationModels.py",
      "lineRange": [5, 69],
      "summary": "Ablation model using only the motion encoder branch with attention pooling and per-task classifiers, including frame-level crossing predictions.",
      "tags": ["ablation", "neural-network", "motion"],
      "complexity": "moderate"
    },
    {
      "id": "class:models/AblationModels.py:VisualOnlyModel",
      "type": "class",
      "name": "VisualOnlyModel",
      "filePath": "models/AblationModels.py",
      "lineRange": [72, 136],
      "summary": "Ablation model using only the ViT visual encoder branch with attention pooling and per-task classifiers, mirroring the full model output format.",
      "tags": ["ablation", "neural-network", "vision"],
      "complexity": "moderate"
    },
    {
      "id": "class:models/AblationModels.py:VanillaConcatModel",
      "type": "class",
      "name": "VanillaConcatModel",
      "filePath": "models/AblationModels.py",
      "lineRange": [139, 223],
      "summary": "Ablation model that concatenates motion and visual features with a simple linear fusion layer instead of cross-attention, serving as a naive multimodal baseline.",
      "tags": ["ablation", "neural-network", "fusion", "baseline"],
      "complexity": "moderate"
    },
    {
      "id": "file:models/Cross_Attention_Module.py",
      "type": "file",
      "name": "Cross_Attention_Module.py",
      "filePath": "models/Cross_Attention_Module.py",
      "summary": "Implements the cross-attention fusion module that attends from motion features to visual features, applies learned attention pooling, and produces per-task logits including frame-level crossing predictions with configurable temporal pooling.",
      "tags": ["component", "neural-network", "attention", "fusion"],
      "complexity": "moderate"
    },
    {
      "id": "class:models/Cross_Attention_Module.py:CrossAttentionModule",
      "type": "class",
      "name": "CrossAttentionModule",
      "filePath": "models/Cross_Attention_Module.py",
      "lineRange": [4, 78],
      "summary": "Multi-head cross-attention module where motion queries attend to visual keys/values, followed by learned attention pooling and per-task classification heads with frame-level logsumexp pooling for crossing prediction.",
      "tags": ["attention", "fusion", "classification", "neural-network"],
      "complexity": "moderate",
      "languageNotes": "Uses PyTorch MultiheadAttention with batch_first=True and logsumexp pooling as a smooth approximation of max pooling for frame-level temporal aggregation."
    },
