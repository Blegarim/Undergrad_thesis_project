      "type": "file",
      "name": "AblationModels.py",
      "filePath": "models/AblationModels.py",
      "summary": "Defines ablation model variants (MotionOnlyModel, VisualOnlyModel, VanillaConcatModel) that isolate individual modalities or use naive fusion, all producing the same output dict format as the full model for fair comparison.",
