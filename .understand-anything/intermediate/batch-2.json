{
  "nodes": [
    {
      "id": "file:config.py",
      "type": "file",
      "name": "config.py",
      "filePath": "config.py",
      "summary": "Central configuration module providing unified d_model dimension (128) and default hyperparameter dictionaries for ViT_Hierarchical and MotionEncoder components.",
      "tags": ["configuration", "utility", "entry-point"],
      "complexity": "simple"
    },
    {
      "id": "function:config.py:vit_args_config",
      "type": "function",
      "name": "vit_args_config",
      "filePath": "config.py",
      "lineRange": [6, 28],
      "summary": "Returns a kwargs dictionary for ViT_Hierarchical with tuned defaults for the PIE dataset, including stage dimensions, layer counts, window sizes, and dropout rates.",
      "tags": ["configuration", "factory", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:config.py:motion_enc_args_config",
      "type": "function",
      "name": "motion_enc_args_config",
      "filePath": "config.py",
      "lineRange": [30, 41],
      "summary": "Returns a kwargs dictionary for MotionEncoder with motion dimension, hidden size, layer count, head count, and dropout defaults.",
      "tags": ["configuration", "factory", "utility"],
      "complexity": "simple"
    },
    {
      "id": "file:main.py",
      "type": "file",
      "name": "main.py",
      "filePath": "main.py",
      "summary": "End-to-end inference pipeline that detects pedestrians in a video using YOLO tracking, runs the multimodal prediction model on extracted sequences, and renders an annotated output video with action/look/cross predictions.",
      "tags": ["entry-point", "inference", "pipeline", "video-processing"],
      "complexity": "complex",
      "languageNotes": "Script-style top-level execution without a main() guard; all logic runs on import. Uses PIE utility for label-to-text mapping."
    },
    {
      "id": "file:models/Vision_Transformer.py",
      "type": "file",
      "name": "Vision_Transformer.py",
      "filePath": "models/Vision_Transformer.py",
      "summary": "Implements a hierarchical Vision Transformer with windowed self-attention, relative position bias, and multi-stage downsampling that processes context-crop video frames into per-frame embeddings of shape [B, T, 128].",
      "tags": ["model", "vision-transformer", "attention", "component"],
      "complexity": "complex",
      "languageNotes": "Uses timm's DropPath for stochastic depth. Window partitioning operates in (B*T, C, H, W) space to process video frame batches efficiently. Supports dynamic/global attention windows via None window_size with lazy position bias initialization."
    },
    {
      "id": "function:models/Vision_Transformer.py:window_partition",
      "type": "function",
      "name": "window_partition",
      "filePath": "models/Vision_Transformer.py",
      "lineRange": [16, 27],
      "summary": "Partitions a spatial feature map into non-overlapping windows of the given size, reshaping from (B, H, W, C) to (num_windows*B, window_size^2, C).",
      "tags": ["utility", "attention", "spatial-ops"],
      "complexity": "simple"
    },
    {
      "id": "function:models/Vision_Transformer.py:window_reverse",
      "type": "function",
      "name": "window_reverse",
      "filePath": "models/Vision_Transformer.py",
      "lineRange": [29, 45],
      "summary": "Reverses window partitioning, reconstructing the spatial feature map from windowed tokens back to (B, H, W, C) layout.",
      "tags": ["utility", "attention", "spatial-ops"],
      "complexity": "simple"
    },
    {
      "id": "class:models/Vision_Transformer.py:WindowAttention",
      "type": "class",
      "name": "WindowAttention",
      "filePath": "models/Vision_Transformer.py",
      "lineRange": [47, 169],
      "summary": "Window-based multi-head self-attention module with learnable relative position bias, supporting both fixed and dynamically-initialized window sizes for global attention stages.",
      "tags": ["attention", "model", "component"],
      "complexity": "complex"
    },
    {
      "id": "class:models/Vision_Transformer.py:WindowTransformerBlock",
      "type": "class",
      "name": "WindowTransformerBlock",
      "filePath": "models/Vision_Transformer.py",
      "lineRange": [171, 251],
      "summary": "Transformer block applying windowed self-attention followed by an MLP with residual connections, layer normalization, and stochastic depth.",
      "tags": ["model", "transformer-block", "component"],
      "complexity": "moderate"
    },
    {
      "id": "class:models/Vision_Transformer.py:ViT_Hierarchical",
      "type": "class",
      "name": "ViT_Hierarchical",
      "filePath": "models/Vision_Transformer.py",
      "lineRange": [253, 378],
      "summary": "Hierarchical Vision Transformer that processes context-crop video frames through a convolutional stem, multiple downsampling stages with windowed attention blocks, global average pooling, and a final projection to produce [B, T, d_model] temporal embeddings.",
      "tags": ["model", "vision-transformer", "entry-point", "component"],
      "complexity": "complex"
    },
    {
      "id": "file:onnx/onnx_export.py",
      "type": "file",
      "name": "onnx_export.py",
      "filePath": "onnx/onnx_export.py",
      "summary": "Exports the trained EnsembleModel to ONNX format with dynamic batch axes, wrapping it in a simplified forward interface that returns only the three task logit tensors.",
      "tags": ["export", "onnx", "deployment", "utility"],
      "complexity": "moderate"
    },
    {
      "id": "function:onnx/onnx_export.py:main",
      "type": "function",
      "name": "main",
      "filePath": "onnx/onnx_export.py",
      "lineRange": [22, 67],
      "summary": "Instantiates the full model pipeline, loads a checkpoint, wraps it in an ONNX-compatible module, and exports to onnx/pedestrian_model.onnx with dynamic batch size support at opset 17.",
      "tags": ["export", "onnx", "deployment"],
      "complexity": "moderate"
    },
    {
      "id": "file:scripts/pedestrian_detection.py",
      "type": "file",
      "name": "pedestrian_detection.py",
      "filePath": "scripts/pedestrian_detection.py",
      "summary": "Provides YOLO-based pedestrian detection and tracking utilities that extract bounding-box tracks from video, smooth trajectories, and produce fixed-length image+motion sequences for model inference.",
      "tags": ["detection", "tracking", "preprocessing", "utility"],
      "complexity": "moderate"
    },
    {
      "id": "function:scripts/pedestrian_detection.py:extract_tracks_from_video",
      "type": "function",
      "name": "extract_tracks_from_video",
      "filePath": "scripts/pedestrian_detection.py",
      "lineRange": [17, 67],
      "summary": "Runs YOLO tracking on a video to detect pedestrians frame-by-frame, accumulating per-track dictionaries of cropped images, bounding boxes, and center coordinates.",
      "tags": ["detection", "tracking", "video-processing"],
      "complexity": "moderate"
    },
    {
      "id": "function:scripts/pedestrian_detection.py:extract_sequences_from_track",
      "type": "function",
      "name": "extract_sequences_from_track",
      "filePath": "scripts/pedestrian_detection.py",
      "lineRange": [82, 108],
      "summary": "Applies a sliding window over a smoothed track to produce fixed-length (T=20) sequences of transformed image tensors and motion vectors ready for model input.",
      "tags": ["preprocessing", "sequence-extraction", "data-pipeline"],
      "complexity": "moderate"
    },
    {
      "id": "function:scripts/pedestrian_detection.py:smooth_track",
      "type": "function",
      "name": "smooth_track",
      "filePath": "scripts/pedestrian_detection.py",
      "lineRange": [69, 80],
      "summary": "Applies a moving average to track center coordinates for temporal smoothing of pedestrian trajectories.",
      "tags": ["preprocessing", "smoothing", "utility"],
      "complexity": "simple"
    }
  ],
