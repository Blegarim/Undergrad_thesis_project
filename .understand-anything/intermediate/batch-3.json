{
  "nodes": [
    {
      "id": "file:models/Motion_Encoder.py",
      "type": "file",
      "name": "Motion_Encoder.py",
      "filePath": "models/Motion_Encoder.py",
      "summary": "Implements the MotionEncoder module that fuses tight-crop image features (via a small CNN) with normalized motion sequences (via 1D convolutions), then applies GRU temporal modeling and multi-head self-attention to produce per-frame embeddings of shape [B, T, d_model].",
      "tags": ["data-model", "component", "temporal-processing", "feature-extraction"],
      "complexity": "moderate",
      "languageNotes": "Uses nn.Parameter for learnable positional encoding and nn.Identity as a conditional no-op projection when hidden_dim equals d_model."
    },
    {
      "id": "class:models/Motion_Encoder.py:MotionEncoder",
      "type": "class",
      "name": "MotionEncoder",
      "filePath": "models/Motion_Encoder.py",
      "lineRange": [5, 100],
      "summary": "nn.Module that encodes tight-crop pedestrian images and motion vectors into a unified temporal representation using CNN feature extraction, 1D temporal convolutions, GRU recurrence, and multi-head self-attention with positional encoding.",
      "tags": ["component", "encoder", "temporal-processing", "feature-fusion"],
      "complexity": "moderate"
    },
    {
      "id": "file:scripts/lmdb_dataset.py",
      "type": "file",
      "name": "lmdb_dataset.py",
      "filePath": "scripts/lmdb_dataset.py",
      "summary": "Provides the LMDBChunkDataset class that reads pre-chunked LMDB files containing video frame sequences and metadata for the PIE dataset, returning tight crops, context crops, motion vectors, and multi-task labels per sample.",
      "tags": ["data-model", "utility", "data-loading", "dataset"],
      "complexity": "moderate",
      "languageNotes": "Implements fork-safe LMDB access by tracking PIDs and reopening environments in child processes, avoiding the LMDB single-process restriction."
    },
    {
      "id": "class:scripts/lmdb_dataset.py:LMDBChunkDataset",
      "type": "class",
      "name": "LMDBChunkDataset",
      "filePath": "scripts/lmdb_dataset.py",
      "lineRange": [10, 101],
      "summary": "PyTorch Dataset that lazily reads pedestrian video sequences from a single LMDB chunk file, decoding JPEG tight/context crops and loading pickled metadata (motion vectors and multi-task labels) per sequence.",
      "tags": ["data-model", "dataset", "data-loading", "lmdb"],
      "complexity": "moderate"
    },
    {
      "id": "file:scripts/train_utils.py",
      "type": "file",
      "name": "train_utils.py",
      "filePath": "scripts/train_utils.py",
      "summary": "Shared training utilities providing batch collation with temporal length capping, early stopping, cross-label remapping, LMDB chunk discovery across directories, memory-pressure gating, and background LMDB pre-warming via multiprocessing.",
      "tags": ["utility", "training", "data-loading", "helper"],
      "complexity": "moderate"
    },
    {
      "id": "function:scripts/train_utils.py:gather_chunks",
      "type": "function",
      "name": "gather_chunks",
      "filePath": "scripts/train_utils.py",
      "lineRange": [46, 71],
      "summary": "Collects all .lmdb files from one or more directories, gracefully skipping missing folders and raising only if no chunks are found at all.",
      "tags": ["utility", "data-loading", "file-discovery"],
      "complexity": "simple"
    },
    {
      "id": "function:scripts/train_utils.py:mp_async_load",
      "type": "function",
      "name": "mp_async_load",
      "filePath": "scripts/train_utils.py",
      "lineRange": [80, 97],
      "summary": "Background process function that opens an LMDB file and reads one metadata key to warm the OS file cache, then reports success or failure via a multiprocessing queue.",
      "tags": ["utility", "data-loading", "multiprocessing", "caching"],
      "complexity": "simple"
    },
    {
      "id": "file:train.py",
      "type": "file",
      "name": "train.py",
      "filePath": "train.py",
      "summary": "Primary training script for the multimodal pedestrian behavior prediction model, orchestrating LMDB chunk-based data loading with background pre-warming, weighted random sampling for class imbalance, AMP training with gradient scaling, per-epoch validation with F1/accuracy metrics, CSV logging, and checkpoint management across full and ablation model types.",
      "tags": ["entry-point", "training", "pipeline", "experiment-tracking"],
      "complexity": "complex",
      "languageNotes": "Uses multiprocessing.Process for LMDB pre-warming to overlap I/O with GPU training, and WeightedRandomSampler with inverse-frequency weights raised to configurable powers per task."
    },
    {
      "id": "function:train.py:compute_class_weights_from_lmdb",
      "type": "function",
      "name": "compute_class_weights_from_lmdb",
      "filePath": "train.py",
      "lineRange": [37, 72],
      "summary": "Scans all LMDB training chunks to compute inverse-frequency class weights per task (actions, looks, crosses), returning a dict of weight tensors for CrossEntropyLoss.",
      "tags": ["utility", "class-imbalance", "data-analysis"],
      "complexity": "moderate"
    },
    {
      "id": "function:train.py:build_sampler_weights",
      "type": "function",
      "name": "build_sampler_weights",
      "filePath": "train.py",
      "lineRange": [85, 123],
      "summary": "Computes per-sample sampling weights from LMDB metadata by combining inverse class weights across all three tasks with configurable power exponents, enabling oversampling of rare crossing events.",
      "tags": ["utility", "class-imbalance", "sampling"],
      "complexity": "moderate"
    },
    {
      "id": "function:train.py:train_one_chunk",
      "type": "function",
      "name": "train_one_chunk",
      "filePath": "train.py",
      "lineRange": [125, 177],
      "summary": "Runs one training pass over a single LMDB chunk's DataLoader using AMP autocast, gradient scaling, gradient clipping, and per-task weighted loss accumulation with the model_forward dispatch.",
      "tags": ["training", "gradient-scaling", "amp"],
      "complexity": "moderate"
    },
    {
      "id": "function:train.py:validate_one_epoch",
      "type": "function",
      "name": "validate_one_epoch",
      "filePath": "train.py",
      "lineRange": [179, 236],
      "summary": "Evaluates the model on a validation chunk under inference mode, accumulating per-task accuracy counts and collecting predictions/targets for downstream F1/precision/recall computation.",
      "tags": ["evaluation", "validation", "metrics"],
      "complexity": "moderate"
    },
    {
      "id": "function:train.py:main",
      "type": "function",
      "name": "main",
      "filePath": "train.py",
      "lineRange": [246, 642],
      "summary": "End-to-end training orchestrator: parses CLI args, builds model from config, loads optional checkpoint, pre-warms LMDB chunks via multiprocessing, iterates epochs with chunk-level training and validation, computes F1/precision/recall, manages learning rate scheduling, early stopping, and checkpoint saving.",
      "tags": ["entry-point", "training", "orchestration", "experiment-tracking"],
      "complexity": "complex"
    },
    {
      "id": "function:train.py:_inverse_class_weights",
      "type": "function",
      "name": "_inverse_class_weights",
      "filePath": "train.py",
      "lineRange": [74, 83],
      "summary": "Computes inverse-frequency weights for a Counter of class labels, returning a dict mapping each class to total/(n_classes * count).",
      "tags": ["utility", "class-imbalance"],
      "complexity": "simple"
    },
    {
      "id": "file:train_two_phase.py",
      "type": "file",
      "name": "train_two_phase.py",
      "filePath": "train_two_phase.py",
      "summary": "Implements a three-phase training strategy for handling severe class imbalance: Phase 1 trains on a balanced subset with FocalLoss, Phase 2 fine-tunes on full augmented data, and Phase 3 freezes the backbone to decouple and retrain only the classification heads.",
      "tags": ["entry-point", "training", "class-imbalance", "pipeline"],
      "complexity": "complex",
      "languageNotes": "Uses FocalLoss with per-task alpha weighting (1:20 for crosses) and a three-phase curriculum that progressively refines decision boundaries on imbalanced data."
    },
    {
      "id": "function:train_two_phase.py:train_epoch",
      "type": "function",
      "name": "train_epoch",
      "filePath": "train_two_phase.py",
      "lineRange": [43, 70],
      "summary": "Runs one full training epoch with AMP, FocalLoss per task, gradient clipping, and returns the average loss per batch.",
      "tags": ["training", "amp", "focal-loss"],
      "complexity": "moderate"
    },
    {
      "id": "function:train_two_phase.py:validate",
      "type": "function",
      "name": "validate",
      "filePath": "train_two_phase.py",
      "lineRange": [73, 104],
      "summary": "Evaluates model under inference mode, computing per-task F1 scores and macro-averaged F1 across actions, looks, and crosses.",
      "tags": ["evaluation", "validation", "metrics"],
      "complexity": "moderate"
    },
    {
      "id": "function:train_two_phase.py:main",
      "type": "function",
      "name": "main",
      "filePath": "train_two_phase.py",
      "lineRange": [118, 342],
      "summary": "Orchestrates the three-phase training curriculum: builds the EnsembleModel, runs balanced-subset training (Phase 1), full-data fine-tuning (Phase 2), and decoupled classifier-only training (Phase 3), with per-phase early stopping, LR scheduling, and CSV logging.",
      "tags": ["entry-point", "training", "orchestration", "curriculum-learning"],
      "complexity": "complex"
    }
