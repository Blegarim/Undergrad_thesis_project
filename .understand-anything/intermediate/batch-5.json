      "name": "PIE_sequence_Dataset_1.py",
      "filePath": "scripts/PIE_sequence_Dataset_1.py",
      "summary": "Core dataset class that loads PIE pedestrian sequences from pickle files, crops tight and context regions from video frames, computes motion deltas (position, size changes), and provides PyTorch DataLoader integration with variable-length padding support.",
      "tags": ["data-model", "utility", "data-pipeline", "dataset"],
      "complexity": "complex",
      "languageNotes": "Uses TurboJPEG with fallback to PIL for fast image decoding; preload mode trades RAM for I/O throughput during training."
    },
    {
