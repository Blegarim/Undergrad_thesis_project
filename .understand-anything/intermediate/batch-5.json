      "lineRange": [21, 141],
      "summary": "PyTorch Dataset that processes raw PIE pedestrian sequences into tight crops, context crops, and 8-dimensional motion vectors (cx, cy, dx, dy, w, h, dw, dh), with optional preloading into RAM for faster iteration.",
      "tags": ["data-model", "dataset", "pytorch"],
      "complexity": "complex"
    },
